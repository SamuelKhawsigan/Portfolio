---
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
const { title = 'Admin' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title} | Admin</title>
  <meta name="robots" content="noindex, nofollow"/>
  <style>
    :root{--bg:#0b111a;--pane:#131c2a;--pane-raised:#1e293b;--ink:#f8fafc;--muted:#94a3b8;--accent:#38bdf8;--accent-hover:#7dd3fc;--line:#233044;--input-line:#334155;--danger:#fda4af;--success:#7dd3fc;--mono:'JetBrains Mono',monospace;--sans:'Source Sans 3',sans-serif}
    *,*::before,*::after{box-sizing:border-box}
    html{background:var(--bg);color-scheme:dark}
    body{margin:0;color:var(--ink);font:1rem/1.5 var(--sans);display:grid;grid-template-columns:248px minmax(0,1fr);grid-template-rows:auto 1fr;min-height:100vh;background:radial-gradient(circle at 80% -20%,#17344b55,transparent 33rem),linear-gradient(140deg,#0c1117,#0e151e)}
    a{color:inherit;text-decoration:none}a:hover{color:var(--accent)}
    a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
    button{font:inherit;cursor:pointer}
    input,textarea,select{font:inherit;background:var(--pane);color:var(--ink);border:1px solid var(--line);padding:.65rem .75rem;width:100%;border-radius:2px}
    input:focus,textarea:focus,select:focus{border-color:var(--accent);outline:none}
    .topbar{grid-column:1/-1;display:flex;align-items:center;flex-wrap:wrap;gap:.5rem 1rem;padding:.7rem 1.5rem;border-bottom:1px solid var(--line);background:#0a0f15cc;backdrop-filter:blur(14px);font:.76rem var(--mono);position:sticky;top:0;z-index:2}
    .topbar .brand{color:var(--accent);font-weight:600;margin-right:auto}
    .topbar form{display:inline}
    .topbar button{background:none;border:1px solid var(--line);color:var(--muted);padding:.3rem .75rem;min-height:44px;font-size:.75rem}
    .topbar > a:not(.brand){display:inline-flex;align-items:center;min-height:38px;padding:.35rem .7rem;border:1px solid var(--line);border-radius:999px;background:var(--pane-raised);transition:background-color 160ms ease,border-color 160ms ease,color 160ms ease,transform 160ms ease}
    .topbar > a:not(.brand):hover{background:var(--accent);border-color:var(--accent);color:#0b1822;transform:translateY(-1px)}
    .topbar button:hover{border-color:var(--accent);color:var(--accent)}
    .sidebar{border-right:1px solid var(--line);padding:1rem .75rem;font-size:.92rem;background:#0d141dcc}
    .sidebar a{display:flex;align-items:center;padding:.72rem .85rem;color:var(--muted);min-height:42px;border-radius:6px;margin:.15rem 0;transition:background-color 160ms ease,color 160ms ease}
    .sidebar a:hover{color:var(--ink);background:var(--pane-raised)}
    .sidebar a[aria-current]{color:var(--ink);background:#1a3041;box-shadow:inset 2px 0 0 var(--accent)}
    .nav-section{font:.66rem var(--mono);color:#647687;padding:1.1rem .85rem .35rem;text-transform:uppercase;letter-spacing:.08em}
    .admin-main{padding:clamp(1.5rem,3vw,3.5rem);min-width:0;max-width:1680px;width:100%;margin:0 auto}
    .admin-main h1{font-size:clamp(1.65rem,3vw,2.2rem);font-weight:600;margin:0 0 1.25rem}
    .msg{padding:.7rem 1rem;margin-bottom:1rem;font-size:.85rem;border-left:3px solid}
    .msg-ok{border-color:var(--success);background:#a6d9ba12;color:var(--success)}
    .msg-err{border-color:var(--danger);background:#f2a7a112;color:var(--danger)}
    .msg-warn{border-color:var(--accent);background:#88c6ea12;color:var(--accent)}
    .btn{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:.5rem 1.1rem;border:1px solid var(--line);border-radius:6px;background:var(--pane);color:var(--ink);font-size:.9rem;cursor:pointer;text-decoration:none;transition:background-color 160ms ease,border-color 160ms ease,color 160ms ease,transform 160ms ease}
    .btn:hover{border-color:var(--accent);color:var(--accent)}
    .btn-primary{border-color:var(--accent);background:var(--accent);color:#0b1822;font-weight:600}
    .btn-primary:hover{background:var(--accent-hover);color:#0b1822;transform:translateY(-1px)}
    .btn-danger{border-color:var(--danger);color:var(--danger)}
    .btn-danger:hover{background:var(--danger);color:#fff}
    .btn-sm{padding:.4rem .7rem;font-size:.8rem}
    .item-list{border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--pane)}
    .item-row{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:.75rem;padding:.8rem 1rem;border-bottom:1px solid var(--line);align-items:center}
    .item-row:last-child{border-bottom:0}
    .item-title{font-size:.9rem}
    .item-meta{font:.72rem var(--mono);color:var(--muted)}
    .badge{display:inline-block;padding:.12rem .45rem;font:.7rem var(--mono);border:1px solid}
    .badge-draft{border-color:var(--muted);color:var(--muted)}
    .badge-published{border-color:var(--accent);color:var(--accent)}
    .field{margin-bottom:1.1rem}
    .field label{display:block;font:.72rem var(--mono);color:var(--muted);margin-bottom:.35rem;text-transform:uppercase;letter-spacing:.04em}
    .field textarea{min-height:100px;resize:vertical}
    .field-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
    .editor-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;align-items:start}
    .editor-grid textarea{min-height:420px;font:.8rem var(--mono)}
    .preview-panel{border:1px solid var(--line);padding:1rem 1.25rem;min-height:420px;font-size:.9rem;line-height:1.7;overflow:auto}
    .preview-panel h1,.preview-panel h2,.preview-panel h3{font-family:var(--mono)}
    .preview-panel code{font-family:var(--mono);font-size:.85em;background:var(--pane);padding:.1em .3em}
    .preview-panel pre{background:var(--pane);border:1px solid var(--line);padding:.85rem;overflow:auto}
    .preview-panel pre code{background:none;padding:0}
    .preview-panel a{color:var(--accent)}
    .unsaved{display:none;width:7px;height:7px;border-radius:50%;background:var(--accent);margin-left:.4rem;vertical-align:middle}
    .unsaved.visible{display:inline-block}
    dialog{background:var(--pane);color:var(--ink);border:1px solid var(--line);padding:1.5rem;max-width:380px}
    dialog::backdrop{background:rgba(0,0,0,.75)}
    dialog h2{margin:0 0 .65rem;font-size:1rem}
    dialog p{margin:0 0 1.1rem;font-size:.88rem;color:var(--muted)}
    .dialog-actions{display:flex;gap:.65rem;justify-content:flex-end}
    .page-actions{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem}
    .page-actions h1{margin:0}
    .help{color:var(--muted);max-width:65ch;margin:0 0 1.5rem}
    .form-section{border:1px solid var(--line);border-radius:8px;background:var(--pane);padding:1.5rem;margin-top:1.25rem}
    .form-section h2{font-size:1.2rem;margin:0 0 1rem}
    .form-actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1.5rem}
    .admin-main>p>a:not(.btn){display:inline-flex;align-items:center;min-height:36px;padding:.35rem .75rem;border:1px solid var(--line);border-radius:999px;background:var(--pane);font-size:.85rem;transition:background-color 160ms ease,border-color 160ms ease,color 160ms ease,transform 160ms ease}.admin-main>p>a:not(.btn):hover{border-color:var(--accent);background:var(--accent);color:#0b1822;transform:translateY(-1px)}
    .thumb{display:block;width:88px;height:68px;object-fit:cover;border:1px solid var(--line)}
    .item-row:has(.thumb){grid-template-columns:88px minmax(0,1fr) auto auto}
    .editor-page{max-width:1200px;margin:0 auto}.editor-page--form{max-width:840px}.admin-page-header{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1.75rem}.admin-page-header h1{margin:.2rem 0 .35rem;color:var(--ink);font-size:1.75rem;font-weight:700;letter-spacing:-.025em}.admin-page-eyebrow{margin:0;color:#64748b;font:.75rem var(--mono);letter-spacing:.08em;text-transform:uppercase}.admin-page-subtitle{margin:0;color:var(--muted);font-size:.875rem;max-width:62ch}.action-button,.secondary-button{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;min-height:40px;padding:.5rem 1rem;border-radius:6px;text-decoration:none;font-size:.875rem;font-weight:600;white-space:nowrap;transition:transform 160ms ease,background-color 160ms ease,border-color 160ms ease,color 160ms ease,box-shadow 160ms ease}.action-button{border:1px solid var(--accent);background:var(--accent);color:#08202d}.action-button:hover,.action-button:focus-visible{background:#7dd3fc;border-color:#7dd3fc;color:#08202d;transform:translateY(-1px);box-shadow:0 8px 18px #00000030}.secondary-button{border:1px solid var(--input-line);background:var(--pane);color:var(--ink)}.secondary-button:hover,.secondary-button:focus-visible{border-color:var(--accent);background:var(--pane-raised);color:var(--ink);transform:translateY(-1px)}.content-list{display:grid;gap:1rem}.content-card{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:center;padding:1.2rem 1.25rem;border:1px solid var(--line);border-radius:10px;background:var(--pane)}.content-card-title{margin:0 0 .45rem;font-size:1rem;font-weight:600;color:var(--ink)}.content-card-meta{display:flex;gap:.45rem;flex-wrap:wrap;align-items:center;color:var(--muted);font:.75rem var(--mono)}.meta-pill,.status-pill{display:inline-flex;align-items:center;min-height:25px;padding:.15rem .5rem;border-radius:999px;font:.7rem var(--mono);line-height:1;border:1px solid}.meta-pill{border-color:var(--input-line);background:var(--pane-raised);color:#cbd5e1}.status-pill--draft{background:rgba(148,163,184,.12);color:#94a3b8;border-color:rgba(148,163,184,.25)}.status-pill--published{background:rgba(56,189,248,.12);color:#38bdf8;border-color:rgba(56,189,248,.25)}.media-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.5rem}.media-card{display:flex;flex-direction:column;min-width:0;overflow:hidden;border:1px solid var(--line);border-radius:10px;background:var(--pane)}.media-card-figure{margin:0;aspect-ratio:16/10;background:#0f172a;border-bottom:1px solid var(--line)}.media-card-figure img{width:100%;height:100%;object-fit:cover;display:block}.media-card--record .media-card-figure img{object-fit:contain;padding:.75rem}.media-card-body{display:flex;flex:1;flex-direction:column;gap:.85rem;padding:1rem}.media-card-body h2{margin:0;color:var(--ink);font-size:1rem;font-weight:600}.media-card-meta{display:flex;flex-wrap:wrap;gap:.4rem}.media-card-footer{display:flex;align-items:center;justify-content:space-between;gap:.75rem;margin-top:auto}.editor-form{display:flex;flex-direction:column;gap:1.5rem}.editor-form .field{display:flex;flex-direction:column;gap:.5rem;margin:0}.editor-form .field label{color:#e2e8f0;font-size:.875rem;font-weight:500;text-transform:none;letter-spacing:0}.editor-form input,.editor-form textarea,.editor-form select{width:100%;padding:.625rem .75rem;border:1px solid var(--input-line);border-radius:6px;background:#0f172a;color:var(--ink);font:inherit}.editor-form textarea{resize:vertical}.editor-form input:focus,.editor-form textarea:focus,.editor-form select:focus{outline:0;border-color:var(--accent);box-shadow:0 0 0 3px rgba(56,189,248,.2)}.editor-form input::placeholder,.editor-form textarea::placeholder{color:#64748b}.editor-form .field small{margin:0;color:var(--muted);font-size:.75rem;line-height:1.4}.editor-form .field-row{gap:1.25rem}.editor-form .form-actions{position:sticky;bottom:0;z-index:1;justify-content:space-between;padding:1.25rem 0;background:#0b111ae8;backdrop-filter:blur(8px);border-top:1px solid var(--line)}.editor-form .form-actions .btn-primary{background:var(--accent);color:#08202d;border-color:var(--accent)}.editor-form .form-actions .btn-primary:hover{background:#7dd3fc;border-color:#7dd3fc}.editor-section{padding:1.5rem;border:1px solid var(--line);border-radius:10px;background:var(--pane)}.editor-section h2{margin:0 0 .5rem;color:var(--ink);font-size:1.15rem;font-weight:600}.editor-section>.help{margin:0 0 1.25rem;font-size:.875rem}.upload-box{padding:1.1rem;border:1px dashed var(--input-line);border-radius:8px;background:#0f172a}.upload-box input[type=file]::file-selector-button{margin-right:.7rem;padding:.45rem .7rem;border:1px solid var(--accent);border-radius:5px;background:#123047;color:#dff5ff;font:600 .8rem var(--sans);cursor:pointer}.upload-box input[type=file]::file-selector-button:hover{background:var(--accent);color:#08202d}.back-action{display:inline-flex;align-items:center;min-height:36px;margin-bottom:1.15rem;color:var(--muted);text-decoration:none;font-size:.875rem}.back-action:hover,.back-action:focus-visible{color:var(--ink)}
    @media(max-width:768px){body{grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto 1fr}.sidebar{display:flex;gap:.25rem;overflow-x:auto;border-right:0;border-bottom:1px solid var(--line);padding:.5rem 1rem;white-space:nowrap}.sidebar .nav-section{display:none}.sidebar a{padding:.55rem .75rem;margin:0}.sidebar a[aria-current]{box-shadow:inset 0 -2px 0 var(--accent)}.editor-grid,.field-row{grid-template-columns:1fr}.item-row,.item-row:has(.thumb){grid-template-columns:60px minmax(0,1fr);gap:.7rem}.item-row .thumb{width:60px;height:60px}.item-row .badge,.item-row .row-actions{grid-column:2}.topbar{padding:.7rem 1rem}}
  </style>
</head>
<body>
<header class="topbar">
  <a class="brand" href="/admin/">SAMUEL / EDITOR</a>
  <a href="/">View site ↗</a>
  <form method="POST" action="/admin/logout">
    <button type="submit">Sign out</button>
  </form>
</header>

<nav class="sidebar" aria-label="Admin navigation">
  <div class="nav-section">Content</div>
  <a href="/admin/" aria-current={path === '/admin/' ? 'page' : undefined}>Overview</a>
  <a href="/admin/posts/" aria-current={path.startsWith('/admin/posts/') ? 'page' : undefined}>Blog</a>
  <a href="/admin/projects/" aria-current={path.startsWith('/admin/projects/') ? 'page' : undefined}>Projects</a>
  <a href="/admin/gallery/" aria-current={path.startsWith('/admin/gallery/') ? 'page' : undefined}>Gallery</a>
  <a href="/admin/achievements/" aria-current={path.startsWith('/admin/achievements/') ? 'page' : undefined}>Achievements</a>
  <a href="/admin/site/" aria-current={path.startsWith('/admin/site/') ? 'page' : undefined}>Site text</a>
</nav>

<main class="admin-main" id="main">
  <slot/>
</main>


</body>
</html>

