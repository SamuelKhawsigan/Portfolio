---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getAchievements, getPublicProjects, publicImageUrl } from '../../lib/site-content';
const [projects, achievements] = await Promise.all([getPublicProjects(), getAchievements()]);
const tools = (value: string | null) => (value ?? '').replace(/[`*_#]/g, '').split(/[\n,|/]/).map((item) => item.trim()).filter(Boolean).slice(0, 4);
const category = (item: (typeof achievements)[number]) => item.category === 'ctf' ? 'ctf' : /github|git|development|programming/i.test(`${item.title} ${item.type} ${item.issuer}`) ? 'tools' : 'security';
---
<Layout title="Achievements & Projects" description="Samuel Khawsigan’s cybersecurity projects, course completions and CTF results.">
  <div class="page-head"><div><p class="edition-label">Technical record / shipped work</p><h1>Achievements &amp; Projects</h1><p>Technical work first. Credentials and team results follow as supporting receipts.</p></div></div>
  <section class="project-showcase" aria-labelledby="projects-heading"><div class="section-heading"><div><p class="eyebrow">01 / Case studies</p><h2 id="projects-heading">Projects</h2></div><span>{projects.length} published</span></div>{projects.length ? <div class="project-case-grid">{projects.map((project,index) => <article class="project-case-card"><a href={`/projects/${project.slug}/`} class="project-case-media" aria-label={`Read ${project.title}`}>{project.cover_image ? <img src={publicImageUrl(project.cover_image) ?? undefined} alt={project.cover_alt ?? ''} loading="lazy" decoding="async"/> : <span>CASE STUDY / {String(index + 1).padStart(2,'0')}</span>}</a><div class="project-case-body"><div class="project-case-meta"><span>{String(index + 1).padStart(2,'0')} // SECURITY ENGINEERING</span><div>{tools(project.tools).map((tool) => <b>{tool}</b>)}</div></div><h3>{project.title}</h3><p>{project.description || project.problem || project.result || 'Technical write-up in progress.'}</p><a class="project-case-action" href={`/projects/${project.slug}/`}>Read writeup <span aria-hidden="true">→</span></a></div></article>)}</div> : <p class="project-empty">Published project case studies will appear here.</p>}</section>
  <section class="credential-section" aria-labelledby="credentials-heading"><div class="section-heading"><div><p class="eyebrow">02 / Receipts</p><h2 id="credentials-heading">Completions &amp; participation</h2></div><span>{achievements.length} records</span></div><div class="credential-filters" role="group" aria-label="Filter credentials"><button type="button" class="is-active" data-filter="all">All</button><button type="button" data-filter="security">Security &amp; Pentesting</button><button type="button" data-filter="ctf">CTF &amp; Team Results</button><button type="button" data-filter="tools">Development &amp; Tools</button></div><div class="credential-grid">{achievements.map((item) => <article class="credential-card" data-card data-category={category(item)}><div><span class="credential-issuer">{item.issuer}</span><h3>{item.title}</h3><p>{item.type} · {item.date}</p></div><button type="button" class="credential-open" data-open data-src={item.src} data-title={item.title} data-issuer={item.issuer} data-date={item.date} data-alt={item.alt}>View receipt</button></article>)}</div></section>
  <div class="credential-lightbox" data-dialog aria-labelledby="dialog-title" role="dialog" aria-modal="true" hidden><button class="credential-close" type="button" data-close aria-label="Close certificate viewer">Close <kbd>Esc</kbd></button><div class="credential-modal"><img data-image src="" alt="" hidden style="display:none"/><div class="credential-modal-copy"><span data-issuer class="credential-issuer"></span><h2 id="dialog-title" data-title></h2><p data-date></p><small data-alt></small></div></div></div>
</Layout>

<style>
.page-head>div>p:last-child{max-width:48ch;color:var(--muted);font-size:1.1rem}.project-showcase,.credential-section{margin-top:clamp(4rem,8vw,7rem)}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding-bottom:1.25rem;border-bottom:1px solid var(--line)}.section-heading h2{margin:0;font:600 clamp(2rem,4vw,3.4rem)/1.05 var(--sans);letter-spacing:-.045em}.section-heading>span{color:var(--muted);font:.75rem var(--mono)}.project-case-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(360px,100%),540px));justify-content:start;gap:1.25rem;margin-top:1.75rem}.project-case-card{overflow:hidden;border:1px solid #1e293b;border-radius:12px;background:rgba(15,23,42,.75);box-shadow:0 1px 0 #ffffff0d inset;backdrop-filter:blur(10px);transition:transform .22s ease,border-color .22s ease,box-shadow .22s ease}.project-case-card:hover{transform:translateY(-5px);border-color:var(--accent);box-shadow:0 22px 42px #00000032}.project-case-media{display:grid;place-items:center;height:clamp(200px,18vw,270px);overflow:hidden;background:#102a3a;color:var(--accent);font:.75rem var(--mono);letter-spacing:.12em;text-decoration:none}.project-case-media img{width:100%;height:100%;object-fit:cover;transition:transform .36s ease}.project-case-card:hover img{transform:scale(1.02)}.project-case-body{display:flex;flex-direction:column;align-items:flex-start;gap:.85rem;padding:1.15rem}.project-case-meta{display:flex;justify-content:space-between;gap:.75rem;width:100%;color:var(--accent);font:.69rem var(--mono);letter-spacing:.06em}.project-case-meta>div{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.35rem}.project-case-meta b{padding:.22rem .45rem;border:1px solid #38556a;border-radius:999px;background:#102635;color:#d7edf8;font:400 .65rem var(--mono);letter-spacing:0}.project-case-body h3{margin:0;color:#f8fafc;font-size:1.22rem}.project-case-body p{display:-webkit-box;overflow:hidden;margin:0;color:var(--muted);line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:2}.project-case-action{display:inline-flex;align-items:center;gap:.45rem;min-height:38px;margin-top:auto;padding:.45rem .85rem;border:1px solid #38bdf8;border-radius:999px;background:rgba(56,189,248,.08);color:#38bdf8;font-weight:600;text-decoration:none}.project-case-action:hover{background:var(--accent);color:var(--paper-ink)}.project-empty{margin-top:1.75rem;padding:2rem;border:1px dashed var(--line);color:var(--muted)}.credential-filters{display:flex;flex-wrap:wrap;gap:.65rem;margin:1.5rem 0}.credential-filters button{min-height:38px;padding:.45rem .85rem;border:1px solid #334155;border-radius:999px;background:rgba(15,23,42,.55);color:#b6c6ce;font:600 .8rem var(--sans);cursor:pointer}.credential-filters button:hover,.credential-filters button:focus-visible,.credential-filters button.is-active{border-color:#38bdf8;background:rgba(56,189,248,.15);color:#f8fafc}.credential-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.credential-card{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.25rem;border:1px solid #1e293b;border-radius:10px;background:rgba(15,23,42,.65)}.credential-card[hidden],.credential-lightbox[hidden],.credential-modal img[hidden]{display:none!important}.credential-issuer{display:inline-flex;padding:.22rem .5rem;border:1px solid #36586d;border-radius:999px;background:#102635;color:#9dd6f1;font:.67rem var(--mono)}.credential-card h3{margin:.65rem 0 .35rem;color:#f8fafc;font-size:1rem;line-height:1.25}.credential-card p{margin:0;color:var(--muted);font-size:.83rem}.credential-open{flex:0 0 auto;min-height:36px;padding:.45rem .85rem;border:1px solid #334155;border-radius:6px;background:#1e293b;color:#e2e8f0;font-size:.8125rem;cursor:pointer}.credential-open:hover,.credential-open:focus-visible{border-color:#38bdf8;color:#38bdf8}.credential-lightbox{position:fixed;z-index:1000;inset:0;display:grid;place-items:center;padding:1rem;background:rgba(6,10,18,.85);backdrop-filter:blur(6px);color:#f8fafc}.credential-close{position:fixed;z-index:2;right:1.5rem;top:1.5rem;min-height:38px;padding:.45rem .75rem;border:1px solid #5a7182;border-radius:999px;background:#0c1620dc;color:#f8fafc;cursor:pointer}.credential-modal{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.25rem;width:min(960px,100%);max-height:calc(100vh - 2rem);padding:clamp(1rem,3vw,1.75rem);border:1px solid #334155;border-radius:12px;background:#0c1620;box-shadow:0 24px 70px #00000080;text-align:center}.credential-modal img{display:block;max-width:min(100%,820px);max-height:68vh;margin:0 auto;border:1px solid #334155;border-radius:8px;object-fit:contain}.credential-modal-copy{max-width:720px}.credential-modal-copy .credential-issuer{margin-inline:auto}.credential-modal h2{margin:.65rem 0;font-size:clamp(1.25rem,2.5vw,2rem)}.credential-modal p,.credential-modal small{color:var(--muted)}@media(max-width:760px){.credential-grid{grid-template-columns:1fr}.credential-card{align-items:flex-start;flex-direction:column}.credential-open{width:100%}.project-case-meta{align-items:flex-start;flex-direction:column}.project-case-meta>div{justify-content:flex-start}.credential-close{right:1rem;top:1rem}.credential-modal img{max-height:60vh}}@media(prefers-reduced-motion:reduce){.project-case-card,.project-case-media img{transition:none}}
</style>
<script is:inline src="/scripts/projects-credentials.js"></script>
