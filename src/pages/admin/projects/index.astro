---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminClient } from '../../../lib/auth';
const supabase = await getAdminClient(Astro);
if (!supabase) return Astro.redirect('/admin/login/');
const { data: projects, error } = await supabase.from('projects')
  .select('id,slug,title,cover_image,cover_alt,status,featured,display_order,updated_at')
  .order('display_order', { ascending: true });
const imageUrl = (path: string | null) => path ? (path.startsWith('/') ? path : supabase.storage.from('portfolio-gallery').getPublicUrl(path).data.publicUrl) : null;
---
<AdminLayout title="Projects">
  <div class="editor-page"><header class="admin-page-header"><div><p class="admin-page-eyebrow">Content / Projects</p><h1>Projects</h1><p class="admin-page-subtitle">Drafts stay out of the public project list. The four original placeholder pages remain until you replace them.</p></div><a href="/admin/projects/new/" class="action-button">+ Add project</a></header>
  {error ? <p class="msg msg-err" role="alert">Couldn’t load projects. Apply migration 005 and check permissions.</p> : projects?.length ? <div class="media-grid">{projects.map(project => <article class="media-card"><figure class="media-card-figure">{imageUrl(project.cover_image) ? <img src={imageUrl(project.cover_image) ?? undefined} alt={project.cover_alt ?? ''} loading="lazy"/> : <span class="tile-empty">PROJECT IMAGE<br/>NOT ADDED</span>}</figure><div class="media-card-body"><h2>{project.title}</h2><div class="media-card-meta"><span class="meta-pill">/{project.slug}</span><span class="meta-pill">Order {project.display_order}</span>{project.featured && <span class="meta-pill">Featured</span>}<span class={`status-pill status-pill--${project.status}`}>{project.status}</span></div><div class="media-card-footer"><span class="content-card-meta">Project record</span><a class="secondary-button" href={`/admin/projects/${project.id}/`}>Edit <span aria-hidden="true">→</span></a></div></div></article>)}</div> : <p class="help">No projects yet.</p>}</div>
</AdminLayout>
<style>.tile-empty{display:grid;place-items:center;width:100%;height:100%;color:var(--muted);font:.75rem/1.6 var(--mono);letter-spacing:.08em;text-align:center}</style>
