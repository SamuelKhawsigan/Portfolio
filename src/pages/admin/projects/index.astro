---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminClient } from '../../../lib/auth';
const supabase = await getAdminClient(Astro);
if (!supabase) return Astro.redirect('/admin/login/');
const { data: projects, error } = await supabase.from('projects')
  .select('id,slug,title,status,featured,display_order,updated_at')
  .order('display_order', { ascending: true });
---
<AdminLayout title="Projects">
  <div class="editor-page"><header class="admin-page-header"><div><p class="admin-page-eyebrow">Content / Projects</p><h1>Projects</h1><p class="admin-page-subtitle">Drafts stay out of the public project list. The four original placeholder pages remain until you replace them.</p></div><a href="/admin/projects/new/" class="action-button">+ Add project</a></header>
  {error ? <p class="msg msg-err" role="alert">Couldn’t load projects. Apply migration 005 and check permissions.</p> : projects?.length ? <div class="content-list">{projects.map(project => <article class="content-card"><div><h2 class="content-card-title">{project.title}</h2><div class="content-card-meta"><span class="meta-pill">/{project.slug}</span><span class="meta-pill">Order {project.display_order}</span>{project.featured && <span class="meta-pill">Featured</span>}<span class={`status-pill status-pill--${project.status}`}>{project.status}</span></div></div><a class="secondary-button" href={`/admin/projects/${project.id}/`}>Edit <span aria-hidden="true">→</span></a></article>)}</div> : <p class="help">No projects yet.</p>}</div>
</AdminLayout>
