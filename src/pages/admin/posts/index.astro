---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminClient } from '../../../lib/auth';

const supabase = await getAdminClient(Astro);
if (!supabase) return Astro.redirect('/admin/login/');

const { data: posts, error } = await supabase
  .from('posts')
  .select('id,slug,title,status,category,content_md,published_at,updated_at')
  .order('updated_at', { ascending: false });
---
<AdminLayout title="Posts">
  <div class="editor-page"><header class="admin-page-header"><div><p class="admin-page-eyebrow">Content / Blog</p><h1>Blog posts</h1><p class="admin-page-subtitle">Write in Markdown, save drafts, and publish when the post is ready for visitors.</p></div><a href="/admin/posts/new" class="action-button">+ New blog post</a></header>
  {error && <p class="msg msg-err" role="alert">Couldn’t load posts. Check the blog database and try again.</p>}
  {posts && posts.length > 0 ? <div class="media-grid">{posts.map(post => { const image = post.content_md?.match(/!\[[^\]]*\]\(([^\s)]+)/)?.[1]; return <article class="media-card"><figure class="media-card-figure">{image ? <img src={image} alt="" loading="lazy"/> : <span class="tile-empty">POST IMAGE<br/>NOT ADDED</span>}</figure><div class="media-card-body"><h2>{post.title}</h2><div class="media-card-meta"><span class="meta-pill">/{post.slug}</span><span class="meta-pill">{post.category}</span>{post.published_at && <span class="meta-pill">{new Date(post.published_at).toLocaleDateString('en-GB', {day:'numeric',month:'short',year:'numeric'})}</span>}<span class={`status-pill status-pill--${post.status}`}>{post.status}</span></div><div class="media-card-footer"><span class="content-card-meta">Blog post</span><div class="card-actions">{post.status === 'published' && <a href={`/blog/${encodeURIComponent(post.slug)}/`} class="secondary-button">View</a>}<a href={`/admin/posts/${post.id}`} class="secondary-button">Edit <span aria-hidden="true">→</span></a></div></div></div></article>})}</div> : !error && <p class="help">No posts yet.</p>}</div>
</AdminLayout>
<style>.card-actions{display:flex;gap:.5rem;flex-wrap:wrap;justify-content:flex-end}.tile-empty{display:grid;place-items:center;width:100%;height:100%;color:var(--muted);font:.75rem/1.6 var(--mono);letter-spacing:.08em;text-align:center}@media(max-width:620px){.card-actions{justify-content:flex-start}}</style>
