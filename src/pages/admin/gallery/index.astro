---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminClient } from '../../../lib/auth';

const supabase = await getAdminClient(Astro);
if (!supabase) return Astro.redirect('/admin/login/');
const { data: photos, error } = await supabase.from('gallery_items')
  .select('id,slug,title,summary,image_path,status,display_order')
  .order('display_order', { ascending: true });
const imageUrl = (path: string) => path.startsWith('/') ? path
  : supabase.storage.from('portfolio-gallery').getPublicUrl(path).data.publicUrl;
---
<AdminLayout title="Gallery">
  <div class="editor-page"><header class="admin-page-header"><div><p class="admin-page-eyebrow">Content / Gallery</p><h1>Gallery</h1><p class="admin-page-subtitle">These photos also appear on Events. Change order on each photo and keep drafts hidden until they are ready.</p></div><a href="/admin/gallery/new/" class="action-button">+ Add photo</a></header>
  {error ? <p class="msg msg-err" role="alert">Couldn’t load the gallery. Apply migration 003 and check permissions.</p> : photos?.length ? <div class="media-grid">{photos.map(photo => <article class="media-card"><figure class="media-card-figure"><img src={imageUrl(photo.image_path)} alt="" loading="lazy"/></figure><div class="media-card-body"><h2>{photo.title}</h2><div class="media-card-meta"><span class="meta-pill">Order {photo.display_order}</span><span class={`status-pill status-pill--${photo.status}`}>{photo.status}</span></div><div class="media-card-footer"><span class="content-card-meta">/{photo.slug}</span><a class="secondary-button" href={`/admin/gallery/${photo.id}/`}>Edit <span aria-hidden="true">→</span></a></div></div></article>)}</div> : <p class="help">No photos yet. Add one to start the gallery.</p>}</div>
</AdminLayout>
