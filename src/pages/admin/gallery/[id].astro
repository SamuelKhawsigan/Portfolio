---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminClient } from '../../../lib/auth';
import { uploadPortfolioImage } from '../../../lib/admin-media';

const supabase = await getAdminClient(Astro);
if (!supabase) return Astro.redirect('/admin/login/');
const id = Astro.params.id ?? '';
const isNew = id === 'new';
const validId = /^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/i.test(id);
const loaded = !isNew && validId ? await supabase.from('gallery_items').select('*').eq('id', id).maybeSingle() : null;
const existing = loaded?.data;
if (!isNew && !existing) Astro.response.status = loaded?.error ? 503 : 404;

let values = existing ? { ...existing, linkedin_url: existing.linkedin_url ?? '', event_slug: existing.event_slug ?? existing.slug } : { slug: '', event_slug: '', title: '', summary: '', alt: '', image_path: '', linkedin_url: '', width: null, height: null, display_order: 60, status: 'draft' };
let error = '';
const imageUrl = (path: string) => path.startsWith('/') ? path
  : supabase.storage.from('portfolio-gallery').getPublicUrl(path).data.publicUrl;

if (Astro.request.method === 'POST' && (isNew || existing)) {
  const origin = Astro.request.headers.get('origin');
  if (origin && origin !== Astro.url.origin) {
    error = 'This request did not come from the gallery editor.';
  } else {
    const form = await Astro.request.formData();
    const read = (key: string) => String(form.get(key) ?? '').trim();
    const rawLinkedInUrl = read('linkedin_url');
    const normaliseLinkedInUrl = (value: string) => {
      if (!value) return { value: '', valid: true };
      const candidate = /^[a-z][a-z\d+.-]*:\/\//i.test(value) ? value : `https://${value}`;
      try {
        const url = new URL(candidate);
        const host = url.hostname.toLowerCase();
        if (url.protocol !== 'https:' || !(host === 'lnkd.in' || host === 'linkedin.com' || host.endsWith('.linkedin.com'))) return { value, valid: false };
        return { value: url.toString(), valid: true };
      } catch { return { value, valid: false }; }
    };
    const linkedIn = normaliseLinkedInUrl(rawLinkedInUrl);
    values = {
      ...values, slug: existing?.status === 'published' ? existing.slug : read('slug').toLowerCase(), event_slug: read('event_slug').toLowerCase(), title: read('title'), summary: read('summary'),
      alt: read('alt'), linkedin_url: linkedIn.value, display_order: Number(read('display_order')), status: read('status'),
      width: read('width') ? Number(read('width')) : null,
      height: read('height') ? Number(read('height')) : null,
    };
    const file = form.get('photo');
    if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(values.slug) || values.slug.length > 100) {
      error = 'URL anchor must use lowercase letters, numbers and hyphens only.';
    } else if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(values.event_slug) || values.event_slug.length > 100) {
      error = 'Event ID must use lowercase letters, numbers and hyphens only.';
    } else if (!values.title || values.title.length > 160 || !values.alt || values.alt.length > 300 || values.summary.length > 500) {
      error = 'Add a title and image description; keep the title, description and alt text within their limits.';
    } else if (!Number.isInteger(values.display_order) || Math.abs(values.display_order) > 100000 || !['draft', 'published'].includes(values.status)) {
      error = 'Choose a valid order and visibility.';
    } else if (!linkedIn.valid || values.linkedin_url.length > 2000) {
      error = 'Enter a valid LinkedIn URL, for example linkedin.com/in/your-name, www.linkedin.com/posts/your-post, or lnkd.in/your-link.';
    } else if (
        (values.width !== null && (!Number.isInteger(values.width) || values.width < 1 || values.width > 20000)) ||
        (values.height !== null && (!Number.isInteger(values.height) || values.height < 1 || values.height > 20000))) {
      error = 'Image dimensions must be whole numbers between 1 and 20,000.';
    } else if (isNew && !(file instanceof File && file.size > 0)) {
      error = 'Choose a photo to upload.';
    } else {
      let uploadedPath = '';
      if (file instanceof File && file.size > 0) {
        const upload = await uploadPortfolioImage(supabase, file);
        error = upload.error;
        uploadedPath = upload.path;
        if (uploadedPath) { values.image_path = uploadedPath; values.width = upload.width ?? null; values.height = upload.height ?? null; }
      }
      if (!error) {
        const row = { slug: values.slug, event_slug: values.event_slug, title: values.title, summary: values.summary,
          alt: values.alt, image_path: values.image_path, linkedin_url: values.linkedin_url || null, width: values.width, height: values.height,
          display_order: values.display_order, status: values.status, updated_at: new Date().toISOString() };
        const save = isNew ? await supabase.from('gallery_items').insert(row).select('id').single()
          : await supabase.from('gallery_items').update(row).eq('id', id).select('id').maybeSingle();
        if (save.data) return Astro.redirect('/admin/gallery/?saved=1', 303);
        if (uploadedPath) await supabase.storage.from('portfolio-gallery').remove([uploadedPath]);
        error = save.error?.code === '23505' ? 'That URL slug is already in use.' : 'Couldn’t save the photo. Check database permissions and try again.';
      }
    }
  }
  if (error && Astro.response.status === 200) Astro.response.status = 400;
}
---
<AdminLayout title={isNew ? 'Add photo' : 'Edit photo'}>
  <div class="editor-page editor-page--form"><a class="back-action" href="/admin/gallery/">← All photos</a>
  {isNew || existing ? <>
    <header class="admin-page-header"><div><p class="admin-page-eyebrow">Content / Gallery</p><h1>{isNew ? 'Add photo' : 'Edit photo'}</h1><p class="admin-page-subtitle">Photos appear on the Gallery and Events pages when published.</p></div></header>
    {error && <p class="msg msg-err" role="alert">{error}</p>}
    <form class="editor-form" method="POST" enctype="multipart/form-data">
      <div class="form-split"><div class="form-primary"><div class="field-grid"><div class="field"><label for="title">Title</label><input id="title" name="title" value={values.title} maxlength="160" required/></div><div class="field"><label for="slug">URL anchor</label><input id="slug" name="slug" value={values.slug} maxlength="100" pattern="[a-z0-9]+(-[a-z0-9]+)*" readonly={existing?.status === 'published'} required/></div></div><div class="field"><label for="summary">Event summary</label><textarea id="summary" name="summary" rows="6" maxlength="500">{values.summary}</textarea></div></div><aside class="form-sidebar">
        {values.image_path && <img class="image-preview" data-image-preview src={imageUrl(values.image_path)} alt={values.alt || 'Current gallery photo'} />}
        <label class="dropzone" for="photo"><span aria-hidden="true">⇧</span><strong data-upload-label>Click to upload or drag and drop</strong><small>JPEG, PNG or WebP up to 8 MB. Metadata is stripped automatically.</small><input id="photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp" required={isNew} aria-describedby="photo-help"/></label><small id="photo-help">Remove private details before uploading.</small>
        <div class="field"><label for="alt">Image description for screen readers</label><input id="alt" name="alt" value={values.alt} maxlength="300" required/></div><div class="field"><label for="event_slug">Event ID</label><input id="event_slug" name="event_slug" value={values.event_slug} maxlength="100" pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="grow-ai-summit" required/><small>Use the same Event ID on photos that belong to one event. Gallery links will open that event on the Events page.</small></div><div class="field"><label for="linkedin_url">LinkedIn event post (optional)</label><input id="linkedin_url" name="linkedin_url" type="url" value={values.linkedin_url} maxlength="2000" placeholder="https://www.linkedin.com/posts/..."/><small>The event’s first photo with a LinkedIn URL supplies its “Read on LinkedIn” button.</small></div><div class="field-grid"><div class="field"><label for="display_order">Order</label><input id="display_order" name="display_order" type="number" value={values.display_order} min="-100000" max="100000" required/></div><div class="field"><label for="status">Visibility</label><select id="status" name="status"><option value="draft" selected={values.status === 'draft'}>Draft</option><option value="published" selected={values.status === 'published'}>Published</option></select></div></div>
        <details><summary>Image dimensions (optional)</summary><div class="field-grid"><div class="field"><label for="width">Width in pixels</label><input id="width" name="width" type="number" value={values.width ?? ''} min="1" max="20000"/></div><div class="field"><label for="height">Height in pixels</label><input id="height" name="height" type="number" value={values.height ?? ''} min="1" max="20000"/></div></div></details>
      </aside></div>
      <div class="form-actions"><button class="btn btn-primary" type="submit">Save photo</button>{!isNew && values.status === 'published' && <a class="btn" href={`/gallery/#${values.slug}`}>View in gallery ↗</a>}</div>
    </form>
    {!isNew && <form class="delete-item-form" action="/admin/delete" method="POST" data-delete-form data-item-name={values.title}><input type="hidden" name="kind" value="gallery"/><input type="hidden" name="id" value={id}/><button class="btn btn-danger" type="submit" data-delete-button>Delete photo</button></form>}
  </> : <h1>{loaded?.error ? 'Couldn’t load photo' : 'Photo not found'}</h1>}</div>
</AdminLayout>
<style>details{border-top:1px solid var(--line);padding-top:1rem}summary{cursor:pointer;color:var(--accent)}details .field-grid{margin-top:1rem}.dropzone>span{font-size:1.5rem;color:var(--accent)}</style>
<script>
  const file = document.querySelector('#photo') as HTMLInputElement | null;
  const label = document.querySelector('[data-upload-label]');
  file?.addEventListener('change', () => { const next = file.files?.[0]; if (!next) return; const preview = document.querySelector('[data-image-preview]') as HTMLImageElement | null; if (preview) preview.src = URL.createObjectURL(next); else { const img = document.createElement('img'); img.className = 'image-preview'; img.dataset.imagePreview = ''; img.src = URL.createObjectURL(next); img.alt = 'Selected gallery photo preview'; file.closest('.form-sidebar')?.prepend(img); } if (label) label.textContent = `Replace ${next.name}`; });
</script>
