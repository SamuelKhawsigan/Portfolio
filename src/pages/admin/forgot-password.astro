---
export const prerender = false;
import { adminConfigured, createPublicBlogClient } from '../../lib/supabase';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/jetbrains-mono/400.css';

Astro.response.headers.set('Cache-Control', 'private, no-store');
let sent = false;
let error = adminConfigured ? '' : 'The site editor isn’t configured yet.';
if (adminConfigured && Astro.request.method === 'POST') {
  const origin = Astro.request.headers.get('origin');
  if (origin && origin !== new URL(Astro.request.url).origin) {
    Astro.response.status = 403;
    error = 'Request rejected.';
  } else {
    const form = await Astro.request.formData();
    const email = String(form.get('email') || '').trim();
    if (email) {
      const supabase = createPublicBlogClient();
      const redirectTo = new URL('/admin/reset-password/', Astro.request.url).toString();
      const result = await supabase?.auth.resetPasswordForEmail(email, { redirectTo });
      sent = !result?.error;
      if (!sent) error = result?.error?.code === 'over_email_send_rate_limit'
        ? 'Too many reset requests. Check your recent Supabase email or try later.'
        : 'Could not send the reset link. Try again in a moment.';
    }
  }
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="robots" content="noindex, nofollow"/>
  <title>Reset admin password</title>
  <style>
    :root{--bg:#101e2a;--pane:#1a2c3a;--ink:#f1f4f2;--muted:#c3d1d8;--accent:#88c6ea;--line:#456170;--danger:#f2a7a1;--mono:'JetBrains Mono',monospace;--sans:'Source Sans 3',sans-serif}
    *{box-sizing:border-box}html{background:var(--bg);color-scheme:dark}
    body{margin:0;color:var(--ink);font:1rem/1.5 var(--sans);display:flex;align-items:center;justify-content:center;min-height:100vh;padding:1rem}
    .card{border:1px solid var(--line);background:var(--pane);padding:2rem;width:100%;max-width:420px}
    h1{margin:0 0 .75rem;font:600 1.5rem/1.2 var(--sans)}p{color:var(--muted);margin:.5rem 0 1.5rem}
    label{display:block;font:.72rem var(--mono);color:var(--muted);margin-bottom:.35rem;text-transform:uppercase}
    input{font:inherit;background:var(--bg);color:var(--ink);border:1px solid var(--line);padding:.55rem .75rem;width:100%}
    input:focus-visible,button:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
    button{display:block;width:100%;min-height:44px;padding:.6rem;border:1px solid var(--accent);background:none;color:var(--accent);font:.85rem var(--mono);cursor:pointer;margin:1.25rem 0 1rem}
    button:hover{background:var(--accent);color:#172c39}a{color:var(--accent);text-underline-offset:.2em}
    .err{border-left:3px solid var(--danger);color:var(--danger);padding:.6rem .8rem;margin-bottom:1rem}
  </style>
</head>
<body>
  <main class="card">
    <h1>Reset your password</h1>
    {sent ? <p role="status">Check your inbox for a reset link. It may take a minute.</p> : <p>Use the email for your site editor account.</p>}
    {error && <div class="err" role="alert">{error}</div>}
    {adminConfigured && !sent && <form method="POST">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" value="samuelkhawsigan.it@gmail.com" required autocomplete="email"/>
      <button type="submit">Send reset link</button>
    </form>}
    <a href="/admin/login/">Back to sign in</a>
  </main>
</body>
</html>
