---
export const prerender = false;
import { adminConfigured, ownerId } from '../../lib/supabase';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/jetbrains-mono/400.css';

Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="robots" content="noindex, nofollow"/>
  <title>Choose a new admin password</title>
  <style>
    :root{--bg:#101e2a;--pane:#1a2c3a;--ink:#f1f4f2;--muted:#c3d1d8;--accent:#88c6ea;--line:#456170;--danger:#f2a7a1;--mono:'JetBrains Mono',monospace;--sans:'Source Sans 3',sans-serif}
    *{box-sizing:border-box}html{background:var(--bg);color-scheme:dark}
    body{margin:0;color:var(--ink);font:1rem/1.5 var(--sans);display:flex;align-items:center;justify-content:center;min-height:100vh;padding:1rem}
    .card{border:1px solid var(--line);background:var(--pane);padding:2rem;width:100%;max-width:420px}
    h1{margin:0 0 .75rem;font:600 1.5rem/1.2 var(--sans)}p{color:var(--muted);margin:.5rem 0 1.5rem}
    .field{margin-bottom:1rem}label{display:block;font:.72rem var(--mono);color:var(--muted);margin-bottom:.35rem;text-transform:uppercase}
    input{font:inherit;background:var(--bg);color:var(--ink);border:1px solid var(--line);padding:.55rem .75rem;width:100%}
    input:focus-visible,button:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
    button{display:block;width:100%;min-height:44px;padding:.6rem;border:1px solid var(--accent);background:none;color:var(--accent);font:.85rem var(--mono);cursor:pointer;margin:1.25rem 0 1rem}
    button:hover{background:var(--accent);color:#172c39}button:disabled{opacity:.5;cursor:wait}a{color:var(--accent);text-underline-offset:.2em}
    .err{border-left:3px solid var(--danger);color:var(--danger);padding:.6rem .8rem;margin-bottom:1rem}
  </style>
</head>
<body>
  <main class="card" id="reset" data-url={import.meta.env.PUBLIC_SUPABASE_URL} data-key={import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || import.meta.env.PUBLIC_SUPABASE_ANON_KEY} data-owner={ownerId}>
    <h1>Choose a new password</h1>
    <p id="message" role="status">{adminConfigured ? 'Checking the reset link…' : 'The site editor isn’t configured yet.'}</p>
    <form id="password-form" hidden>
      <div class="field"><label for="password">New password</label><input id="password" type="password" minlength="12" required autocomplete="new-password"/></div>
      <div class="field"><label for="confirm">Confirm password</label><input id="confirm" type="password" minlength="12" required autocomplete="new-password"/></div>
      <button type="submit">Save new password</button>
    </form>
    <a href="/admin/login/">Back to sign in</a>
  </main>
  {adminConfigured && <script src="../../scripts/reset-password.ts"></script>}
</body>
</html>
