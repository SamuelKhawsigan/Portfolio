---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminClient } from '../../../lib/auth';
const supabase = await getAdminClient(Astro);
if (!supabase) return Astro.redirect('/admin/login/');
const { data: items, error } = await supabase.from('achievement_items')
  .select('id,slug,title,category,status,image_path,display_order')
  .order('display_order', { ascending: true });
const imageUrl = (path: string) => path.startsWith('/') ? path
  : supabase.storage.from('portfolio-gallery').getPublicUrl(path).data.publicUrl;
---
<AdminLayout title="Achievements">
  <div class="editor-page"><header class="admin-page-header"><div><p class="admin-page-eyebrow">Content / Achievements</p><h1>Achievements</h1><p class="admin-page-subtitle">Course completions, workshop participation, and team CTF results. Keep rankings labelled as team results.</p></div><a href="/admin/achievements/new/" class="action-button">+ Add record</a></header>
  {error ? <p class="msg msg-err" role="alert">Couldn’t load records. Apply migration 004 and check permissions.</p> : items?.length ? <div class="media-grid">{items.map(item => <article class="media-card media-card--record"><figure class="media-card-figure"><img src={imageUrl(item.image_path)} alt="" loading="lazy"/></figure><div class="media-card-body"><h2>{item.title}</h2><div class="media-card-meta"><span class="meta-pill">{item.category}</span><span class="meta-pill">Order {item.display_order}</span><span class={`status-pill status-pill--${item.status}`}>{item.status}</span></div><div class="media-card-footer"><span class="content-card-meta">/{item.slug}</span><a class="secondary-button" href={`/admin/achievements/${item.id}/`}>Edit <span aria-hidden="true">→</span></a></div></div></article>)}</div> : <p class="help">No records yet.</p>}</div>
</AdminLayout>
