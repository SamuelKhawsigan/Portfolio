---
export const prerender = false;
import { adminConfigured, createSupabaseClient, ownerId } from '../../lib/supabase';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/jetbrains-mono/400.css';

Astro.response.headers.set('Cache-Control', 'private, no-store');
const supabase = adminConfigured ? createSupabaseClient(Astro.cookies, Astro.request.headers) : null;

// Redirect authenticated owner away from login
const user = (await supabase?.auth.getUser())?.data.user;
if (user && ownerId && user.id === ownerId) {
  return Astro.redirect('/admin/');
}

let error = supabase ? '' : 'The site editor isn’t configured yet.';
if (!supabase) Astro.response.status = 503;
if (supabase && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') || '');
  const password = String(form.get('password') || '');
  const { data, error: authError } = await supabase.auth.signInWithPassword({ email, password });
  if (authError || !data.user) {
    error = 'Invalid credentials.';
  } else if (!ownerId || data.user.id !== ownerId) {
    await supabase.auth.signOut();
    error = 'Access denied.';
  } else {
    return Astro.redirect('/admin/', 303);
  }
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Admin login</title>
  <meta name="robots" content="noindex, nofollow"/>
  <style>
    :root{--bg:#101e2a;--pane:#1a2c3a;--ink:#f1f4f2;--muted:#c3d1d8;--accent:#88c6ea;--line:#456170;--danger:#f2a7a1;--mono:'JetBrains Mono',monospace;--sans:'Source Sans 3',sans-serif}
    *{box-sizing:border-box}html{background:var(--bg);color-scheme:dark}
    body{margin:0;color:var(--ink);font:1rem/1.5 var(--sans);display:flex;align-items:center;justify-content:center;min-height:100vh;padding:1rem}
    .card{border:1px solid var(--line);background:var(--pane);padding:2rem;width:100%;max-width:390px}
    h1{margin:0 0 1.5rem;font:600 1.5rem/1.2 var(--sans);color:var(--ink)}
    .field{margin-bottom:1rem}
    .field label{display:block;font:.72rem var(--mono);color:var(--muted);margin-bottom:.35rem;text-transform:uppercase}
    input{font:inherit;background:var(--bg);color:var(--ink);border:1px solid var(--line);padding:.55rem .75rem;width:100%}
    input:focus-visible{border-color:var(--accent);outline:2px solid var(--accent);outline-offset:2px}
    button{display:block;width:100%;min-height:44px;padding:.6rem;border:1px solid var(--accent);background:none;color:var(--accent);font:.85rem var(--mono);cursor:pointer;margin-top:1.25rem}
    button:hover{background:var(--accent);color:#172c39}
    button:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
    .reset-link{display:inline-block;margin-top:1rem;color:var(--muted);text-underline-offset:.2em}
    .reset-link:hover{color:var(--accent)}
    .reset-link:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
    .err{border-left:3px solid var(--danger);background:#f2a7a112;color:var(--danger);padding:.6rem .8rem;font-size:.85rem;margin-bottom:1rem}
  </style>
</head>
<body>
  <div class="card">
    <h1>Samuel / Site editor</h1>
    {error && <div class="err" role="alert">{error}</div>}
    {supabase && <form method="POST">
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email"/>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" required autocomplete="current-password"/>
      </div>
      <button type="submit">Sign in</button>
      <a class="reset-link" href="/admin/forgot-password/">Forgot password?</a>
    </form>}
  </div>
</body>
</html>
